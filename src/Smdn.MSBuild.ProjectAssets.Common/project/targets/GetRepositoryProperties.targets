<Project>
  <Target Name="GetRepositoryProperties">
    <PropertyGroup>
      <_IsInsideOfRepositoryTree>false</_IsInsideOfRepositoryTree>
    </PropertyGroup>

    <!-- If $(RepositoryType) is not explicitly specified, it is assumed to be 'git'. -->
    <CallTarget
      Targets="GetRepositoryProperties_Git"
      Condition=" '$(RepositoryType)' == 'git' or '$(RepositoryType)' == '' "
    />
    <CallTarget Targets="GetRepositoryProperties_VersionOrRepositoryTypeNotSupported"/>
  </Target>

  <Target Name="GetRepositoryProperties_Git">
    <PropertyGroup Condition="'$(GitCommandLineInterfacePath)' == ''">
      <GitCommandLineInterfacePath Condition="$([MSBuild]::IsOsPlatform('Windows'))">&quot;$(ProgramFiles)\Git\cmd\git.exe&quot;</GitCommandLineInterfacePath>
      <GitCommandLineInterfacePath Condition="$([MSBuild]::IsOSUnixLike())">git</GitCommandLineInterfacePath>
      <GitCommandLineInterfacePath Condition="'$(GitCommandLineInterfacePath)' == ''">git</GitCommandLineInterfacePath>
    </PropertyGroup>

    <Exec
      Command="$(GitCommandLineInterfacePath) rev-parse --git-dir"
      Condition=" '$(GitCommandLineInterfacePath)' != '' and '$(RepositoryBranch)' == '' "
      ConsoleToMSBuild="true"
      IgnoreExitCode="true"
      StandardOutputImportance="Low"
      StandardErrorImportance="Low"
    >
      <Output TaskParameter="ExitCode" PropertyName="_GitRevParseGitDirExitCode" />
    </Exec>

    <PropertyGroup>
      <_IsInsideOfRepositoryTree Condition="'$(_GitRevParseGitDirExitCode)' == '0'">true</_IsInsideOfRepositoryTree>
    </PropertyGroup>

    <Exec
      Command="$(GitCommandLineInterfacePath) branch --show-current"
      Condition=" '$(_IsInsideOfRepositoryTree)' == 'true' and '$(GitCommandLineInterfacePath)' != '' and '$(RepositoryBranch)' == '' "
      ConsoleToMSBuild="true"
      EchoOff="true"
      StandardOutputImportance="Low"
    >
      <Output TaskParameter="ConsoleOutput" PropertyName="RepositoryBranch" />
    </Exec>

    <Exec
      Command="$(GitCommandLineInterfacePath) rev-parse HEAD"
      Condition=" '$(_IsInsideOfRepositoryTree)' == 'true' and '$(GitCommandLineInterfacePath)' != '' and '$(RepositoryCommit)' == '' "
      ConsoleToMSBuild="true"
      EchoOff="true"
      StandardOutputImportance="Low"
    >
      <Output TaskParameter="ConsoleOutput" PropertyName="RepositoryCommit" />
    </Exec>
  </Target>

  <Target
    Name="GetRepositoryProperties_VersionOrRepositoryTypeNotSupported"
    Condition="('$(RepositoryBranch)' == '') and ('$(RepositoryCommit)' == '')"
  >
    <Error
      Text="Could not get repository properties (type: $(RepositoryType))"
      File="$(MSBuildProjectFile)"
      Condition="'$(_IsInsideOfRepositoryTree)' == 'true'"
    />
    <Warning
      Text="Could not get repository properties; project may not be in the repository tree. (type: $(RepositoryType))"
      File="$(MSBuildProjectFile)"
      Condition="'$(_IsInsideOfRepositoryTree)' != 'true'"
    />
  </Target>
</Project>
