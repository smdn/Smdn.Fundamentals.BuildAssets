dotnet_diagnostic.SA1602.severity  = none       # Enumeration items should be documented
dotnet_diagnostic.SA1603.severity  = error      # Documentation should contain valid XML
dotnet_diagnostic.SA1604.severity  = suggestion # Element documentation should have summary
