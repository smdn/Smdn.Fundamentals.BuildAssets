<Project>
  <PropertyGroup Label="StyleCop code analysis">
    <!-- set default to CodeAnalysisRuleSet here if not set -->
    <CodeAnalysisRuleSet
      Condition=" '$(CodeAnalysisRuleSet)' == '' "
    >$(MSBuildThisFileDirectory)\StyleCop.Analyzers.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
</Project>
